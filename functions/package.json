{
  "name": "boltlog-functions",
  "description": "Cloud Functions for Boltlog",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "fix-iam": "node grant-gcf-bucket-access.js",
    "fix-iam-and-deploy": "node grant-gcf-bucket-access.js && npm run deploy",
    "set-admin-claim": "node scripts/set-admin-claim.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "@google-cloud/vision": "^4.3.2"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.14.0"
  },
  "boltlog": {
    "deployStamp": "2026-04-11-1"
  },
  "private": true
}
